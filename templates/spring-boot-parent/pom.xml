<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!-- Parent Spring Boot : fournit dependencyManagement + pluginManagement -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <!-- Coordonnées de VOTRE parent -->
  <groupId>com.example</groupId>
  <artifactId>spring-boot-parent</artifactId>
  <version>1.0.1</version>
  <packaging>pom</packaging>
  <name>Spring Boot Parent</name>
  <description>
    Parent Maven commun centralisant les propriétés et les versions des dépendances partagées par les modules Spring Boot.
  </description>

  <!-- Propriétés centralisées -->
  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <modelmapper.version>3.2.0</modelmapper.version>
  </properties>

  <!--
    Gestion centralisée des dépendances.
    Le BOM de Spring Boot est DÉJÀ importé par spring-boot-starter-parent :
    l'importer à nouveau ici est redondant, mais sans effet de bord.
    Les trois dépendances qui suivent n'ont PAS de <version> → elles sont
    inutiles (Spring Boot les gère déjà) et doivent être supprimées,
    sinon Maven échouera à la validation du modèle.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.modelmapper</groupId>
        <artifactId>modelmapper</artifactId>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Configuration des plugins héritée par tous les modules -->
  <build>
    <pluginManagement>
      <plugins>
        <!-- Config par défaut héritée, surchargeable par les enfants -->
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Plugins réellement exécutés pour TOUS les modules -->
      <!-- ⚠ Ne PAS mettre spring-boot-maven-plugin ici :
           il s'exécuterait aussi sur les librairies. -->
    </plugins>
  </build>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/ahmedkadmiri-dev/base-de-connaissances</url>
    </repository>
  </distributionManagement>

</project>